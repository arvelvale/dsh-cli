[Unit]
Description=DeepSeek Harness daemon (public HTTPS via Caddy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dsh
Group=dsh
WorkingDirectory=/opt/dsh/repo
StateDirectory=dsh
Environment=HOME=/var/lib/dsh
Environment=DSH_HOME=/var/lib/dsh
Environment=DSH_DAEMON_WORKSPACE=/srv/dsh/workspace
Environment=DSH_DAEMON_TOKEN_FILE=%d/daemon-token
Environment=DSH_TELEMETRY_DISABLED=1
Environment=PATH=/opt/dsh/node/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/dsh/provider.env
LoadCredential=daemon-token:/etc/dsh/daemon-token
ExecStart=/opt/dsh/node/bin/node --import tsx/esm /opt/dsh/repo/apps/cli/src/dsh-cli.ts daemon --port 3080 --trusted-host __DOMAIN__
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/dsh/workspace /opt/dsh/repo

[Install]
WantedBy=multi-user.target
